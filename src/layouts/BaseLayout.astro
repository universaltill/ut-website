---
import { I18N, langPillLabel, langPillText } from '../lib/marketingPages';
import { LANGS, SOURCE_LOCALE, dirOf, infoOf } from '../lib/locales';
import { esc, fallbackNoteHtml } from '../lib/chrome';
// No stylesheet import here on purpose. site/styles.css (linked below, served
// straight from publicDir) is the ONLY stylesheet on this site — these pages
// used to also load a Tailwind-based global.css that redeclared the same
// tokens and its own body font. Two stylesheets meant these pages quietly
// rendered in a different typeface from every hand-written page, which is
// exactly the "am I on a different website?" feeling a visitor gets before
// they can name why.

// The locales, their direction and the AI label all come from the published
// list (src/lib/locales.ts): no locale is named here. Every locale gets its
// own URL prefix (/tr-tr/blog), because a language that exists only behind a
// click is a language search engines never index. Region-tagged because VAT,
// receipt law and payment rails differ by COUNTRY, not language (ADR-0038).
export { LANGS, SOURCE_LOCALE };
const DEFAULT_LANG = SOURCE_LOCALE;

// BCP-47 uppercases the region subtag; crawlers accept either, humans read it.
// Exported so JSON-LD's `inLanguage` (blog/[slug].astro) uses the exact same
// mapping as this file's own <html lang> and hreflang tags, rather than a
// second copy that could drift.
export const bcp47 = (code: string) => infoOf(code).bcp47;

interface Props {
  title: string;
  description: string;
  /** URL language prefix: undefined for English at the root. */
  lang?: string;
  /** Path of this page WITHOUT the language prefix, in its canonical
   *  trailing-slash form, e.g. "/blog/" (ut-docs#3798). */
  path: string;
  /** Locales that have a real version of this page (not the English
   *  stand-in). Only these are declared as hreflang alternates; defaults to
   *  every locale (ut-docs#3811). */
  translatedLangs?: string[];
  /** This locale has no translation and is showing the English original:
   *  the canonical points at the en-gb URL, so a search engine indexes the
   *  original once rather than five copies of it (ut-docs#3811). */
  isFallback?: boolean;
  /** Keep this page out of search results (an unreviewed machine translation
   *  of a post or help page, ADR-0177 section 7). It also gets no hreflang. */
  noindex?: boolean;
  /** i18n keys the page body renders with t(); the fallback note appears when
   *  any of them (or the header/footer) falls back to English. */
  keys?: string[];
  /** Show the "English is binding" notice (legal pages served in English). */
  legalEnglish?: boolean;
}

const { title, description, lang, path, translatedLangs = LANGS, isFallback = false, noindex = false, keys = [], legalEnglish = false } = Astro.props;
const current = lang ?? DEFAULT_LANG;
const dir = dirOf(current);
const canonical = new URL(isFallback || noindex ? `/${SOURCE_LOCALE}${path}` : Astro.url.pathname, Astro.site);

// The chrome's data-i18n strings, rendered in this page's locale at build
// time — the same dict site/i18n.js applies at runtime, so a crawler that
// doesn't run JS reads /de-de/plugins/ in German, not English (ut-docs#3811).
// Exported so a page's own data-i18n strings use the same lookup.
export const t = (locale: string, key: string): string =>
  I18N[locale]?.[key] ?? I18N[SOURCE_LOCALE][key] ?? key;
const T = (key: string) => t(current, key);
// A key the locale does not ship shows English; mark it lang="en" so a screen
// reader switches voice and the page can say so once.
const fbKeys = new Set<string>(I18N[current]?._fb ?? []);
const F = (key: string) => (fbKeys.has(key) ? `<span lang="en" dir="ltr" data-i18n-fallback>${esc(T(key))}</span>` : esc(T(key)));
const CHROME_KEYS = ['nav.solutions', 'nav.tour', 'nav.why', 'nav.hardware', 'nav.plugins', 'nav.news', 'nav.help', 'nav.about', 'nav.get', 'nav.menu', 'foot.tagline', 'foot.owner', 'foot.rights', 'foot.impressum', 'foot.privacy', 'foot.terms'];
const usedFallback = [...CHROME_KEYS, ...keys].some((k) => fbKeys.has(k));
const pagePath = path === '/' ? '' : path;

// Prefix a site path with the current language, so navigating out of a
// Turkish page lands on a Turkish page rather than silently switching to
// English.
// Every link stays inside the current locale, English included: an unprefixed
// URL says nothing about language, so choosing English after Turkish would
// land on a page that still renders Turkish from the stored preference.
const L = (p: string) => `/${current}${p === '/' ? '' : p}` || '/';

// hreflang alternates for THIS page in every language — the pairing that
// tells a search engine these are translations of one page rather than
// duplicates competing with each other. Only real translations are listed;
// an English fallback declares none (it isn't its own canonical, so it isn't
// a member of the set — ut-docs#3811).
const alternates = isFallback || noindex
  ? []
  : LANGS.filter((code) => translatedLangs.includes(code)).map((code) => ({
      code,
      href: new URL(`/${code}${path}`, Astro.site).href,
    }));
---

<!DOCTYPE html>
<html lang={bcp47(current)} dir={dir}>
<head>
  <meta charset="utf-8" />
  <script is:inline>if(location.hostname==="universaltill.com"){location.replace("https://www.universaltill.com"+location.pathname+location.search+location.hash);}</script>
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  {alternates.map((a) => <link rel="alternate" hreflang={bcp47(a.code)} href={a.href} />)}
  {!isFallback && !noindex && <link rel="alternate" hreflang="x-default" href={new URL(`/${DEFAULT_LANG}${path}`, Astro.site).href} />}
  <link rel="alternate" type="application/rss+xml" title="Universal Till News" href={new URL(`/${current}/blog/rss.xml`, Astro.site).href} />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — Universal Till</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/logo.svg" />
  <!-- The site's own stylesheet, and the only one. Header, footer, .btn,
       .card, .section and the body typeface all come from here, so these
       pages are the same site rather than a lookalike. -->
  <link rel="stylesheet" href="/styles.css" />
  <script defer src="/i18n-data.js"></script>
  <script defer src="/i18n.js"></script>
  <!-- nav.js too: the hamburger below is markup this header carries
       (ut-docs#458). Without it the toggle would render and do nothing at
       <=560px on exactly the pages a visitor reaches from a search result. -->
  <script defer src="/nav.js"></script>
  <!-- Cookie banner + GA4, only after Accept (ut-docs#3507). -->
  <script defer src="/consent.js"></script>
</head>
<body>

<!-- The SAME header as site/index.html, link for link: same wrapper, same
     #site-nav panel, same .nav-actions/.nav-toggle markup that nav.js and
     styles.css key off, the same 22x30 logo and the same "Get started"
     action. Only the hrefs differ — in-page anchors must be absolute from a
     /blog/* URL, and each is language-prefixed. It previously carried a
     shortened four-link menu, a larger logo and a Download button, so
     arriving here felt like leaving the site.
     tests/site-consistency.spec.js compares the two headers on every build. -->
<header class="nav">
  <a class="brand" href={L('/')}>
    <img src="/logo.svg" alt="" width="22" height="30" />
    <span>Universal <strong>Till</strong></span>
  </a>
  <nav id="site-nav">
    <a href={`${L('/')}#solutions`} data-i18n="nav.solutions" set:html={F('nav.solutions')}></a>
    <a href={`${L('/')}#tour`} data-i18n="nav.tour" set:html={F('nav.tour')}></a>
    <a href={`${L('/')}#why`} data-i18n="nav.why" set:html={F('nav.why')}></a>
    <a href={`${L('/')}#hardware`} data-i18n="nav.hardware" set:html={F('nav.hardware')}></a>
    <a href={L('/plugins/')} data-i18n="nav.plugins" set:html={F('nav.plugins')}></a>
    <a href={L('/blog/')} data-i18n="nav.news" set:html={F('nav.news')}></a>
    <a href={L('/help/')} data-i18n="nav.help" set:html={F('nav.help')}></a>
    <a href={`${L('/')}#about`} data-i18n="nav.about" set:html={F('nav.about')}></a>
  </nav>
  <div class="nav-actions">
    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label={T('nav.menu')} data-i18n-aria-label="nav.menu">
      <span class="nav-toggle-bars" aria-hidden="true"></span>
    </button>
    <a class="btn" href={L('/find-your-setup')} data-i18n="nav.get" set:html={F('nav.get')}></a>
    <!-- i18n.js rewrites this href at runtime to carry the current page, so
         choosing a language returns you HERE rather than to the homepage. -->
    <a class="lang-link" rel="nofollow" href={`/${current}/language?from=${encodeURIComponent(path)}`} aria-label={langPillLabel(current)} data-i18n-aria-label="nav.language">{langPillText(current)}</a>
  </div>
</header>

{usedFallback && <Fragment set:html={fallbackNoteHtml(I18N[current])} />}
{legalEnglish && <div class="mt-band mt-band--note" role="note" data-legal-english><p class="mt-band__text">{T('site.legal_english_binding')}</p></div>}

<main>
  <slot />
</main>

<!-- Same footer as site/index.html, tagline included and same 19x26 mark. -->
<footer class="foot">
  <div class="foot-brand">
    <img src="/logo.svg" alt="" width="19" height="26" />
    <span>Universal <strong>Till</strong></span>
  </div>
  <p class="foot-tagline" data-i18n="foot.tagline" set:html={F('foot.tagline')}></p>
  <p class="foot-owner" data-i18n="foot.owner" set:html={F('foot.owner')}></p>
  <p class="foot-rights" data-i18n="foot.rights" set:html={F('foot.rights')}></p>
  <!-- Same three links as site/*.html's footer (ut-docs#1552) — but here,
       unlike site/*.html, THROUGH L() like every other link in this file
       (review caught an earlier draft hardcoding these unprefixed, which
       is right for site/*.html — plain HTML pages never rewrite a generic
       href — but wrong here: this file's whole point is that every link
       stays in the current locale, and an unprefixed /legal/impressum
       301s to /en-gb/legal/impressum, ejecting a non-English
       reader out of their own locale on click). A real space (not just
       adjacent whitespace) around "·" so Astro's HTML compression can't
       collapse it away the way it does a newline+indent — verified against
       site/*.html's own rendering, where the newline is preserved and
       renders as a space; tests/site-consistency.spec.js doesn't compare
       this footer link-for-link (only .foot-tagline's presence), but no
       reason to let it drift anyway. -->
  <p class="foot-legal">
    <a href={L('/help/')} data-i18n="nav.help" set:html={F('nav.help')}></a>{' · '}
    <a href={L('/legal/impressum/')} data-i18n="foot.impressum" set:html={F('foot.impressum')}></a>{' · '}
    <a href={L('/legal/privacy/')} data-i18n="foot.privacy" set:html={F('foot.privacy')}></a>{' · '}
    <a href={L('/legal/terms/')} data-i18n="foot.terms" set:html={F('foot.terms')}></a>
  </p>
</footer>

</body>
</html>
