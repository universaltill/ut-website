---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="Blog" description="News and updates from Universal Till.">
  <section class="section">
    <div class="section-head">
      <h1>Blog</h1>
      <p class="section-sub">News and updates from Universal Till.</p>
    </div>

    {posts.length === 0 && <p class="muted">No posts yet.</p>}

    <div class="grid" style="display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fill,minmax(280px,1fr))">
      {posts.map((post) => (
        <a class="card" style="display:block" href={`/blog/${post.id}`}>
          {post.data.coverImage && (
            <img
              src={post.data.coverImage}
              alt={post.data.title}
              loading="lazy"
              style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:.5rem;margin-bottom:.75rem"
            />
          )}
          <h3>{post.data.title}</h3>
          <p style="color:var(--muted);font-size:.85rem;margin:.3rem 0">
            {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
            {' · '}{post.data.author}
          </p>
          <p>{post.data.excerpt}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
