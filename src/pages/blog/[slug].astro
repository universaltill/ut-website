---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article class="section" style="max-width:44rem">
    <p style="color:var(--muted);font-size:.9rem;margin-bottom:.3rem">
      {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
      {' · '}{post.data.author}
    </p>
    <h1>{post.data.title}</h1>
    <div style="line-height:1.7;color:var(--ink-soft)">
      <Content />
    </div>
    <p style="margin-top:2rem"><a href="/blog">← Back to blog</a></p>
  </article>
</BaseLayout>
