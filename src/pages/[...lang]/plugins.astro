---
import BaseLayout, { LANGS, t } from '../../layouts/BaseLayout.astro';
import PluginLogo from '../../lib/PluginLogo.astro';
import { groupByType, loadPlugins } from '../../lib/plugins';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

// Which plugins exist and their data (each repo's manifest.json, fetched at
// build time) is decided in src/lib/plugins.ts. This page is the grid of small
// cards only; the description, details, permissions and the download live on
// each plugin's own page (ut-docs#4645, same pattern as the till store #4180).
const groups = groupByType(await loadPlugins());

const { lang } = Astro.params;
// The page's own copy comes from site/i18n.js's `pluginspage.*` keys, in this
// locale, at build time — it used to be hard-coded English under all five
// URLs, which Google folded together as duplicates (ut-docs#3811).
const T = (key) => t(lang, key);
// A type with no label key (a new ADR-0002 type) shows its raw name rather
// than the key.
const label = (key, fallback) => (T(key) === key ? fallback : T(key));
const hasKey = (key) => T(key) !== key;
---

<BaseLayout
  title={T('pluginspage.title')}
  description={T('pluginspage.desc')}
  lang={lang}
  path="/plugins/"
>
  {/* The page's own copy follows the locale. The plugin names and taglines
      come from each repo's manifest.json and are English only — so those
      elements keep dir="ltr" lang="en", or a Farsi visitor gets English
      prose laid out right-to-left (ut-docs#353). */}
  <section class="section">
    <div class="section-head">
      <h1 data-i18n="pluginspage.title">{T('pluginspage.title')}</h1>
      <p class="section-sub" data-i18n="pluginspage.intro">{T('pluginspage.intro')}</p>
    </div>

    {groups.map(([type, plugins]) => (
      <div class="plugin-group">
        <h2 class="plugin-group-title" data-i18n={hasKey(`pluginspage.type.${type}`) ? `pluginspage.type.${type}` : undefined}>
          {label(`pluginspage.type.${type}`, type)}
        </h2>
        <ul class="plugin-grid">
          {plugins.map((p) => (
            <li>
              <a class="plugin-card" href={`/${lang}/plugins/${p.slug}/`}>
                <PluginLogo plugin={p} />
                <div class="plugin-card-text">
                  <h3 dir="ltr" lang="en">{p.name}</h3>
                  <p class="plugin-tagline" dir="ltr" lang="en">{p.tagline}</p>
                  <span class="plugin-badges">
                    <span class="plugin-badge" data-i18n={hasKey(`pluginspage.kind.${type}`) ? `pluginspage.kind.${type}` : undefined}>
                      {label(`pluginspage.kind.${type}`, type)}
                    </span>
                    <span class="plugin-badge free" data-i18n="pluginspage.free">{T('pluginspage.free')}</span>
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <p class="muted" style="margin-top:2rem" data-i18n-html="pluginspage.footer" set:html={T('pluginspage.footer')} />
  </section>
</BaseLayout>
