---
import { getCollection } from 'astro:content';
import BaseLayout, { LANGS } from '../../../layouts/BaseLayout.astro';

// One built page per language: /blog, /tr/blog, /zh/blog, /fa/blog. The rest
// param is undefined for English, which is what keeps the English URL at the
// root. A language that exists only behind a click is a language search
// engines never index — and a visitor who bookmarks a Turkish page gets a
// Turkish page back.
//
// The post BODIES are still English; only the site chrome translates (via
// i18n.js's data-i18n pass). Translating the content itself is ut-docs#475.
export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout
  title="News"
  description="Release notes, roadmap updates and stories from shops running Universal Till."
  lang={lang}
  path="/blog"
>
  <section class="section">
    <div class="section-head">
      <h1>News</h1>
      <p class="section-sub" data-i18n="news.sub">Release notes, roadmap updates, and stories from shops running Universal Till.</p>
    </div>

    {posts.length === 0 && <p class="muted">No posts yet.</p>}

    <div class="grid" style="display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fill,minmax(280px,1fr))">
      {posts.map((post) => (
        <a class="card" style="display:block" href={`/${lang}/blog/${post.id}`}>
          {post.data.coverImage && (
            <img
              src={post.data.coverImage}
              alt={post.data.title}
              loading="lazy"
              style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:.5rem;margin-bottom:.75rem"
            />
          )}
          <h3>{post.data.title}</h3>
          <p style="color:var(--muted);font-size:.85rem;margin:.3rem 0">
            {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
            {' · '}{post.data.author}
          </p>
          <p>{post.data.excerpt}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
