---
import BaseLayout, { LANGS, t } from '../../../layouts/BaseLayout.astro';
import { getLocalizedPosts } from '../../../lib/blogPosts';
import { formatDate } from '../../../lib/dates';

// One built page per language: /blog, /tr/blog, /zh/blog, /fa/blog. The rest
// param is undefined for English, which is what keeps the English URL at the
// root. A language that exists only behind a click is a language search
// engines never index — and a visitor who bookmarks a Turkish page gets a
// Turkish page back.
//
// The post BODIES are still English; only the site chrome translates (via
// i18n.js's data-i18n pass). Translating the content itself is ut-docs#475.
export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

// Every post appears in every locale, in that locale's translation where one
// exists and in English where it does not — one list per locale, never a
// shorter Turkish blog than English one. Shared with sitemap.xml/rss.xml so
// all three agree on exactly the same set (src/lib/blogPosts.ts).
const posts = await getLocalizedPosts(lang);
---

<BaseLayout
  title={t(lang, 'nav.news')}
  description={t(lang, 'news.sub')}
  lang={lang}
  path="/blog/"
>
  <section class="section">
    <div class="section-head">
      <h1 data-i18n="nav.news">{t(lang, 'nav.news')}</h1>
      <p class="section-sub" data-i18n="news.sub">{t(lang, 'news.sub')}</p>
    </div>

    {posts.length === 0 && <p class="muted" data-i18n="news.empty">{t(lang, 'news.empty')}</p>}

    <div class="grid" style="display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fill,minmax(280px,1fr))">
      {posts.map(({ post, slug }) => (
        <a class="card" style="display:block" href={`/${lang}/blog/${slug}/`}>
          {post.data.coverImage && (
            <img
              src={post.data.coverImage}
              alt={post.data.title}
              loading="lazy"
              style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:.5rem;margin-bottom:.75rem"
            />
          )}
          <h3>{post.data.title}</h3>
          <p style="color:var(--muted);font-size:.85rem;margin:.3rem 0">
            <bdi><time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date, lang)}</time></bdi>
            {' · '}{post.data.author}
          </p>
          <p>{post.data.excerpt}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
