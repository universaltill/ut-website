{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/styles.css",
      "/logo.svg",
      "/i18n.js",
      "/downloads/*",
      "/download.html",
      "/start.html",
      "/store.html",
      "/language.html",
      "/blog/*",
      "/admin/*",
      "/plugins/*"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    {
      "route": "/download",
      "rewrite": "/download.html"
    },
    {
      "route": "/start",
      "rewrite": "/start.html"
    },
    {
      "route": "/store",
      "rewrite": "/store.html"
    },
    {
      "route": "/language",
      "rewrite": "/language.html"
    },
    {
      "route": "/admin",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/admin/*",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/zitadel?post_login_redirect_uri=/admin",
      "statusCode": 302
    }
  },
  "auth": {
    "identityProviders": {
      "customOpenIdConnectProviders": {
        "zitadel": {
          "registration": {
            "clientIdSettingName": "ZITADEL_CLIENT_ID",
            "clientCredential": {
              "clientSecretSettingName": "ZITADEL_CLIENT_SECRET"
            },
            "openIdConnectConfiguration": {
              "wellKnownOpenIdConfiguration": "https://id.universaltill.com/.well-known/openid-configuration"
            }
          },
          "login": {
            "nameClaimType": "preferred_username",
            "scopes": [
              "openid",
              "profile",
              "email"
            ]
          }
        }
      }
    }
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
