{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/styles.css",
      "/logo.svg",
      "/i18n.js",
      "/nav.js",
      "/downloads/*",
      "/download.html",
      "/start.html",
      "/store.html",
      "/language.html",
      "/blog/*",
      "/admin",
      "/admin/*",
      "/plugins/*"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    {
      "route": "/download",
      "rewrite": "/download.html"
    },
    {
      "route": "/start",
      "rewrite": "/start.html"
    },
    {
      "route": "/store",
      "rewrite": "/store.html"
    },
    {
      "route": "/language",
      "rewrite": "/language.html"
    }
  ]
}
